<%@ page import="com.foodorder.model.User" %>
<%
    User navUser = (User) session.getAttribute("user");
    Integer cartCount = (Integer) session.getAttribute("cartCount");
    if (cartCount == null) cartCount = 0;
%>
<nav class="navbar">
    <div class="container nav-inner">
        <a class="logo" href="<%=request.getContextPath()%>/jsp/home.jsp">Food Delivery</a>
        <div class="nav-links">
            <a href="<%=request.getContextPath()%>/jsp/home.jsp">Home</a>
            <a href="<%=request.getContextPath()%>/restaurants">Restaurants</a>
            <% if (navUser != null) { %>
                <a href="<%=request.getContextPath()%>/orders">My Orders</a>
                <a href="<%=request.getContextPath()%>/cart">Cart (<span class="cart-count"><%=cartCount%></span>)</a>
                <a href="<%=request.getContextPath()%>/profile">Profile</a>
                <% if ("ADMIN".equals(navUser.getRole())) { %><a href="<%=request.getContextPath()%>/admin">Admin</a><% } %>
                <span class="welcome">Welcome <%= navUser.getUsername() %></span>
                <a class="btn secondary" href="<%=request.getContextPath()%>/logout">Logout</a>
            <% } else { %>
                <a class="btn secondary" href="<%=request.getContextPath()%>/jsp/login.jsp">Login</a>
                <a class="btn" href="<%=request.getContextPath()%>/jsp/register.jsp">Register</a>
            <% } %>
        </div>
    </div>
</nav>
